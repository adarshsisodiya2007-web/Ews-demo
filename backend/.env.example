# ─────────────────────────────────────────────────────────────────────────────
#  SIH 26001 — EWS-NER Environment Variables
#  Copy this file, rename to .env, fill in real values before docker-compose up
#  DO NOT commit .env with real credentials to git
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE (defaults work for local Docker demo) ────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/ews_ner
SPRING_DATASOURCE_USERNAME=ews_user
SPRING_DATASOURCE_PASSWORD=ews_secure_pass

# ── JWT AUTH (change this to a strong random string in production) ────────────
APP_JWT_SECRET=ews-ner-sih26001-jwt-demo-secret-key-2026-hackathon-minimum-256-bits
APP_JWT_EXPIRY_MS=86400000

# ── MinIO Object Storage (defaults work for local Docker demo) ────────────────
APP_MINIO_ENDPOINT=http://minio:9000
APP_MINIO_ACCESS_KEY=ews_minio_user
APP_MINIO_SECRET_KEY=ews_minio_pass
APP_MINIO_BUCKET=ews-uploads

# ── SMS ALERTS via Twilio ─────────────────────────────────────────────────────
# Set APP_ALERT_SMS_ENABLED=true and fill Twilio credentials to enable real SMS
# Free trial at: https://www.twilio.com/try-twilio
# Without these, alerts still show in the dashboard ticker (via WebSocket)
APP_ALERT_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── MISC ──────────────────────────────────────────────────────────────────────
APP_SEED_ENABLED=true
