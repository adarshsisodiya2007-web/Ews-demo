# SATARK EWS — Frontend Environment Variables
# Copy to .env or configure in Vercel Project Settings > Environment Variables

# Backend Spring Boot API URL (e.g. http://localhost:8080 for local dev, or https://your-backend.railway.app for production)
# If left empty in production, SATARK runs in reliable SIH 2026 Demo Mode with full demo OTP & offline support.
VITE_API_BASE_URL=http://localhost:8080

# Optional WebSocket URL (defaults to ws:// or wss:// on your VITE_API_BASE_URL)
# VITE_WS_URL=ws://localhost:8080/ws
